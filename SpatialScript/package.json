{
  "name": "spatialscript",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --filter ./core --filter ./consumers/web build && pnpm agent-prompt:sync",
    "agent-prompt:sync": "node tools/sync-agent-prompt.mjs",
    "agent-prompt:check": "node tools/sync-agent-prompt.mjs --check",
    "conformance:exports": "node verification/conformance/exports.test.mjs",
    "test": "pnpm -r test",
    "conformance:node": "node verification/conformance/run-node.mjs",
    "conformance:web": "node consumers/web/harness/run.mjs",
    "conformance:jsc": "pnpm --filter @spatialscript/core test:jsc",
    "robustness": "node verification/scenarios/run-robustness.mjs",
    "scenarios": "node verification/scenarios/run-node.mjs",
    "docs:check": "node docs/check-snippets.mjs",
    "parity:comparator": "node verification/parity/compare.test.mjs",
    "parity": "verification/parity/run-all.sh",
    "perf": "node verification/perf/check.mjs",
    "verify": "pnpm test && pnpm conformance:matcher && pnpm conformance:exports && pnpm conformance:node && pnpm conformance:jsc && pnpm robustness && pnpm scenarios && pnpm docs:check && pnpm agent-prompt:check && pnpm parity:comparator && pnpm conformance:web && node consumers/web/harness/scenarios.mjs",
    "gauntlet": "node verification/scenarios/run-gauntlet.mjs",
    "conformance:matcher": "node verification/conformance/match.test.mjs"
  }
}
